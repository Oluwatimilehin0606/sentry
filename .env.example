# Copy this file to .env and adjust if needed. Never commit .env.

# API server port (the Vite dev server proxies /api to it)
API_PORT=4000

# development | test | production
NODE_ENV=development

# Where the web app runs (used for CORS / links)
APP_URL=http://localhost:5173

# Deferred to Phase 1 (database + auth):
# DATABASE_URL=postgres://sentry:<password>@localhost:5432/sentry_dev
# BETTER_AUTH_SECRET=<long random string>
