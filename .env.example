# Copy this file to .env and fill it in. Never commit .env.
# The demo build (`npm start`) also reads an optional .env.demo for demo-only settings, and
# `npm run db:seed -- --online` reads .env.online; see README.

# development | test | production
NODE_ENV=development

# Where Sentry runs: the website and API together, on this address (npm run dev and the demo).
APP_URL=http://localhost:5173

# Local Postgres. Create the "sentry" role first (see README "Database setup"),
# then run `npm run db:create`. Tests automatically use sentry_test instead of sentry_dev.
# Use a password with only letters and numbers, or URL-encode special characters.
DATABASE_URL=postgres://sentry:CHANGE_ME@localhost:5432/sentry_dev

# Secret used to sign login sessions. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Optional, for trying Sentry on the pretend website (never in production):
# run `npm run demo:site`, then uncomment these two lines and restart `npm run dev`.
# SENTRY_E2E_SITES='{"bakery.test":{"https":8443,"http":8081,"caFile":"e2e/.tmp/ca.pem"}}'
# SENTRY_E2E_TXT_FILE=e2e/.tmp/txt.json

# Alert emails. In development they go to the local test inbox (`npm run mail`), which is the default:
# SMTP_URL=smtp://localhost:1025
# MAIL_FROM=Sentry <alerts@sentry.local>
# Times in emails are shown in this time zone:
# APP_TIMEZONE=Africa/Lagos
