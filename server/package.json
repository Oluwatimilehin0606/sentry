{
  "name": "@sentry/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/index.ts",
    "start": "node scripts/start.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "scan": "node scripts/scan.ts",
    "test-alert": "node --env-file-if-exists=../.env scripts/send-test-alert.ts",
    "due-now": "node --env-file-if-exists=../.env scripts/due-now.ts",
    "seed:history": "node --env-file-if-exists=../.env scripts/seed-history.ts",
    "db:create": "node --env-file-if-exists=../.env scripts/db-create.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "selfsigned": "^5.5.0",
    "supertest": "^7.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
